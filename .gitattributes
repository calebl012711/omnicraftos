# Git LFS tracking for large binary assets
*.wasm filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
# Notice hashes describe the original bytes, across checkout platforms.
public/licenses/desktop/** -text
public/licenses/frontend/** -text
integration/desktop-notice-sources/** -text

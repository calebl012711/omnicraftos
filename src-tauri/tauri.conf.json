{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniCraft OS",
  "version": "0.1.0",
  "identifier": "studio.omnicraft.os",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "OmniCraft OS", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}

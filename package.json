{
  "name": "omnicraft-os",
  "version": "0.1.0",
  "private": true,
  "description": "OmniCraft OS \u2014 creative workspaces with browser recording, audio editing and upstream Rust/WASM editors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "upstream:status": "node scripts/upstream.mjs status",
    "upstream:check": "node scripts/upstream.mjs check",
    "upstream:licenses": "node scripts/upstream.mjs licenses",
    "upstream:overlays": "node scripts/upstream-manager.mjs verify-overlays",
    "upstream:apply-overlays": "node scripts/upstream-manager.mjs apply-overlays",
    "verify:recorder": "node scripts/verify-recorder.mjs",
    "verify:capture-library": "node scripts/verify-capture-library.mjs",
    "verify:desktop-home": "node scripts/verify-desktop-home.mjs",
    "verify:editors": "node scripts/verify-upstream-workflows.mjs",
    "verify:music": "node scripts/verify-music.mjs",
    "desktop:dev": "tauri dev --no-watch",
    "desktop:build": "node scripts/build-desktop-low-impact.mjs",
    "desktop:info": "tauri info",
    "desktop:notices": "node scripts/desktop-notices.mjs",
    "desktop:upstream-check": "node scripts/check-desktop-upstream.mjs",
    "verify:desktop-notices": "node scripts/verify-desktop-notices.mjs",
    "upstream:build": "node scripts/build-upstream.mjs",
    "verify:filmcraft": "node scripts/verify-filmcraft.mjs",
    "verify:audio-source": "node scripts/verify-audio-source.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "verify:model-library": "node scripts/verify-model-library.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "prebuild": "node scripts/prepare-assets.mjs --fetch",
    "assets:prepare": "node scripts/prepare-assets.mjs --fetch",
    "assets:check": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@waveform-playlist/browser": "16.0.1",
    "@waveform-playlist/core": "12.6.2",
    "@waveform-playlist/playout": "12.5.5",
    "@waveform-playlist/recording": "13.0.6",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "6.1.19",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

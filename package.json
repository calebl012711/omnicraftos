{
  "name": "mosaic-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Mosaic Forge — Free, local-first unified creative suite and parametric CAD workspace",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "upstream:status": "node scripts/upstream-manager.mjs status",
    "upstream:check": "node scripts/upstream-manager.mjs check --output public/upstream-report.json",
    "upstream:licenses": "node scripts/upstream-manager.mjs verify-licenses"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
